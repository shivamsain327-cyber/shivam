<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. config.json holds the web-service token and the WhatsApp API
     key, so it is excluded from cloud backup and device-to-device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="config.json" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="config.json" />
    </device-transfer>
</data-extraction-rules>
